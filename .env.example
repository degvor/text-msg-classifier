# Copy to .env (`make env`) and adjust. .env is gitignored.
#
# The previous version hardcoded these credentials in five places
# (docker-compose.yaml, both Spark scripts, Django settings.py) and committed
# Django's SECRET_KEY. Everything now reads from here.

# --- Postgres ----------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=streamdb
POSTGRES_USER=streamuser
POSTGRES_PASSWORD=change-me-in-real-deployments

# --- Kafka -------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=posts
# Experiments use a single partition so micro-batch composition is
# deterministic. Raise this only for scalability benchmarks.
KAFKA_NUM_PARTITIONS=1

# --- Paths -------------------------------------------------------------------
STREAMCLS_DATA_ROOT=/data

# --- Spark -------------------------------------------------------------------
# Pinned rather than local[*] so partitioning, and therefore model fitting, is
# reproducible across machines with different core counts.
SPARK_MASTER=local[4]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=8
SPARK_MAX_OFFSETS_PER_TRIGGER=500
SPARK_TRIGGER_SECONDS=10

# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-not-secret-generate-a-real-one-for-prod
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
